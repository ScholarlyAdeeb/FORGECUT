# Hosted transcription (Auto Captions on the server).
# On Vercel: Project → Settings → Environment Variables. Never commit a real token.
# Without HF_TOKEN, Auto Captions runs in the browser instead.

# Hugging Face access token with "Make calls to Inference Providers" permission.
HF_TOKEN=

# Optional: which model (default openai/whisper-large-v3)
# HF_ASR_MODEL=openai/whisper-large-v3

# Optional: a dedicated Inference Endpoint URL instead of the shared router
# HF_ASR_URL=https://xxxx.endpoints.huggingface.cloud

# Optional: extra origins allowed to call /api/transcribe (comma-separated),
# e.g. a custom domain served by a different host
# ALLOWED_ORIGINS=https://forgecut.example.com

# Optional: requests per IP per minute, per server instance (default 20)
# RATE_LIMIT_PER_MIN=20
